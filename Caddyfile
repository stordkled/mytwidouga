# DOMAIN and APP_PORT come from docker-compose.yml (.env).
# Caddy obtains and renews the HTTPS certificate for DOMAIN by itself.
# Access logs are left off because their URLs would record what was watched.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy app:{$APP_PORT:3000} {
		# Send video bytes as they arrive instead of buffering them.
		flush_interval -1
	}
}
