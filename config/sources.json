  "maxProxyStreams": 6,
  "maxProxyStreamsPerClient": 2,
  "proxyQueueMs": 8000,
  "hideFailedSources": true,
  "hideAfterFailures": 3,
  "hiddenRetryMs": 600000,
  "cacheTtlMs": 1800000,
  "resolveTtlMs": 180000,
  "domainMemoryTtlMs": 1800000,
  "mirrorTimeoutMs": 12000,
  "requestTimeoutMs": 60000,
  "sources": {
    "twivideo": {
      "hidden": true,
      "bases": ["https://twivideo.net"],
      "startOffsetSec": 0
    },
    "twikeep": {
      "enabled": false,
      "bases": ["https://www.twikeep.com"],
      "metric": "downloads",
      "startOffsetSec": 0
    },
    "85po": {
      "bases": [
        "https://www.85po.com",
        "https://www.85po.net",
        "https://www.85ro.com"
      ],
      "startOffsetSec": 0
    },
    "pornhub": {
      "bases": [
        "https://www.pornhub.com",
        "https://jp.pornhub.com",
        "https://rt.pornhub.com"
      ],
      "startOffsetSec": 5
    },
    "tokyomotion": {
      "bases": ["https://www.tokyomotion.net"],
      "startOffsetSec": 0
    },
    "twihozon": {
      "enabled": false,
      "bases": ["https://www.twihozon.org"],
      "startOffsetSec": 0
    }
  }
}
