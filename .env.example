# Copy to .env on the VPS and fill in. Never commit .env.
# See README: VPSに置く手順.

# Public domain for Caddy/HTTPS (required by docker compose)
DOMAIN=

# Shared login for friends
BASIC_AUTH_USER=friend
# Required by docker compose. Generate one, e.g. openssl rand -base64 18
BASIC_AUTH_PASS=

# Port inside the container (outside is always 80/443)
PORT=3000

# App memory limit
APP_MEMORY_LIMIT=512m
